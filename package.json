{
  "name": "agentflow-ai",
  "version": "1.0.0",
  "description": "Agentic AI Operations Automation Platform (Agentflow_AI)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"next dev -p 3000\"",
